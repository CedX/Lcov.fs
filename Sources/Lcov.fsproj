<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Company>Cedric-Belin.fr</Company>
		<Copyright>© Cédric Belin</Copyright>
		<Description>Parse and format to LCOV your code coverage reports.</Description>
		<Product>LCOV Reports for F#</Product>
		<Version>5.0.1</Version>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>CedX</Authors>
		<IncludeSymbols>true</IncludeSymbols>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>ReadMe.md</PackageReadmeFile>
		<PackageTags>coverage;formatter;lcov;parser;test;writer</PackageTags>
		<RepositoryUrl>https://github.com/CedX/Lcov.fs.git</RepositoryUrl>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AssemblyName>Belin.Lcov.FSharp</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<HotReloadAutoRestart>true</HotReloadAutoRestart>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutDir>../Binaries</OutDir>
		<RootNamespace>Belin.Lcov</RootNamespace>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(RootNamespace).Tests" />
		<None Include="../Icon.png" Pack="true" PackagePath="" />
		<None Include="../ReadMe.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="Tokens.fs" />
		<Compile Include="BranchCoverage.fs" />
		<Compile Include="FunctionCoverage.fs" />
		<Compile Include="LineCoverage.fs" />
		<Compile Include="SourceFile.fs" />
		<!-- <Compile Include="Report.fs" /> -->
	</ItemGroup>
</Project>
